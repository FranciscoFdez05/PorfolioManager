{
  "name": "porfoliomanager-frontend",
  "version": "4.9.0",
  "private": true,
  "type": "module",
  "description": "Tooling del frontend. La aplicación no se empaqueta: js/ se sirve tal cual con etiquetas <script>, así que aquí solo hay linter, formateador y las pruebas de los módulos de js/core/.",
  "scripts": {
    "lint": "eslint js",
    "lint:fix": "eslint js --fix",
    "format": "prettier --write \"js/**/*.js\" \"css/**/*.css\"",
    "format:check": "prettier --check \"js/**/*.js\" \"css/**/*.css\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.4.2",
    "vitest": "^5.0.5"
  }
}
