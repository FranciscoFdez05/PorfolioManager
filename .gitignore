# =========================
# DATA (mantener carpeta, ignorar contenido)
# =========================
data/*
data/backups/*
data/JSON/*
!data/.gitkeep

# =========================
# LOGS
# =========================
logs/*.log
!logs/.gitkeep

# =========================
# PYTHON CACHE
# =========================
__pycache__/
*.pyc
*.pyo
*.pyd

# =========================
# ENTORNOS
# =========================
.env*
!.env.example
venv/

# =========================
# APIs KEYs
# ========================= 
API/*.key
!API/.gitkeep

# =========================
# TEMPORALES
# =========================
*.tmp
*.bak
*.swp
*.log

# =========================
# EDITORES
# =========================
.vscode/
.idea/

# =========================
# SISTEMA
# =========================
.DS_Store
Thumbs.db

# =========================
# Claude
# =========================
.claude/


# Tooling del frontend (eslint/prettier). package.json y package-lock.json sí
# se versionan: `npm ci` en CI los necesita.
node_modules/

# Cobertura de tests
.coverage
coverage.xml
htmlcov/

# Salidas de las pruebas del frontend (vitest)
coverage/
.vitest/
