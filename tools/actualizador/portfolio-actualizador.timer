[Unit]
Description=Comprueba cada poco si se ha pedido una actualización desde Ajustes

[Timer]
# Medio minuto entre pasadas. Es lo que tarda el botón en dejar de parecer
# roto, y la pasada en vacío es un `test -f`: no cuesta nada.
OnBootSec=1min
OnUnitActiveSec=30s
AccuracySec=5s
Unit=portfolio-actualizador.service

[Install]
WantedBy=timers.target
