# Copia este archivo como .env y rellena los valores antes de lanzar el contenedor.
#
# Reparto de responsabilidades:
#
#   .env        → SECRETOS y credenciales. Nunca se versiona (está en
#                 .gitignore). Es lo único que hay que rellenar aquí.
#   config.ini  → AJUSTES de despliegue (puerto, timeouts, límites, rutas…).
#                 Versionado, documentado opción por opción.
#
# Además, cualquier ajuste de config.ini se puede sobrescribir puntualmente
# desde aquí con su variable de entorno: el entorno tiene prioridad sobre el
# fichero. Al final de este archivo hay una lista de las más habituales, todas
# comentadas. Úsalas solo para un override concreto —por ejemplo, un valor que
# deba cambiar por máquina—; el sitio natural de un ajuste es config.ini.

# ═══════════════════════════════════════════════════════════════════════════════
# SECRETOS — rellena esta parte
# ═══════════════════════════════════════════════════════════════════════════════

# ── Claves de las APIs de mercado ─────────────────────────────────────────────
FINNHUB_API_KEY=tu_clave_finnhub

# Múltiples keys EODHD separadas por coma (rotación automática)
EODHD_API_KEYS=tu_clave_EODHD1,tu_clave_EODHD2

# ── Clave de firma de la aplicación ───────────────────────────────────────────
# Cifra la sesión y, en reposo, las claves de API y las credenciales. Si cambia,
# se invalidan las sesiones y deja de poder descifrarse lo ya guardado.
# Genera una clave aleatoria con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_aleatoria_larga

# ── Credenciales de acceso ────────────────────────────────────────────────────
# Se usan solo en el primer arranque (o si data/auth.dat no existe).
# Tras el primer login puedes cambiarlas desde Ajustes > Credenciales.
LOGIN_USERNAME=admin

# Genera el hash con (ajusta las iteraciones si cambiaste [seguridad]
# hash_iteraciones en config.ini):
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('tu_contraseña', method='pbkdf2:sha256:600000'))"
LOGIN_PASSWORD_HASH=

# ── Clave del Atajo de iOS ────────────────────────────────────────────────────
# Lo normal es generarla en fichero, no ponerla aquí:
#   python tools/generar_clave_movimientos.py
# la guarda en API/movimientos.key (ignorado por git, cifrado con SECRET_KEY).
# Descomenta solo si prefieres pasarla por entorno.
#MOVIMIENTOS_SECRET_KEY=

# ── Zona horaria del contenedor ───────────────────────────────────────────────
# Afecta a las marcas de tiempo de los logs y de los backups automáticos.
TZ=Europe/Madrid


# ═══════════════════════════════════════════════════════════════════════════════
# OVERRIDES OPCIONALES de config.ini — deja todo comentado salvo que los necesites
# ═══════════════════════════════════════════════════════════════════════════════
# El valor entre corchetes es el que trae config.ini por defecto. La lista
# completa de ajustes está en config.ini y en python/core/settings.py.

# ── Servidor ──────────────────────────────────────────────────────────────────
# El puerto sale de [server] port en config.ini. Si lanzas el stack con
# ./docker-up.sh, PORT se exporta automáticamente con ese valor, de modo que el
# mapeo de puertos y el contenedor no se puedan desincronizar. Definirlo aquí
# solo sirve si arrancas "docker compose up" a mano.
#PORT=5000
#HOST=0.0.0.0
#FLASK_DEBUG=false

# Activa la cookie de sesión segura; ponlo en true solo si hay HTTPS delante
#HTTPS_ENABLED=false
#COOKIE_SAMESITE=Lax
#MAX_CUERPO_MB=5
#MAX_SUBIDA_MB=256

# ── Gunicorn (solo dentro del contenedor) ─────────────────────────────────────
#GUNICORN_WORKERS=2
#GUNICORN_THREADS=4
#GUNICORN_TIMEOUT=120
#GUNICORN_KEEP_ALIVE=5

# ── Registros ─────────────────────────────────────────────────────────────────
#LOG_NIVEL=INFO
#LOG_FORMATO=%(asctime)s [%(levelname)s] %(name)s - %(message)s

# ── Seguridad ─────────────────────────────────────────────────────────────────
#MAX_INTENTOS_LOGIN=8
#BLOQUEO_SEGUNDOS=300
#HASH_ITERACIONES=600000

# ── Atajo de iOS (POST /api/movimiento) ──────────────────────────────────────
#MOVIMIENTOS_ACTIVADO=true
#MOVIMIENTOS_REDES_PERMITIDAS=192.168.1.0/24,10.0.0.0/24
#MOVIMIENTOS_TOLERANCIA_SEGUNDOS=60

# ── Base de datos y backups ───────────────────────────────────────────────────
#DB_TIMEOUT=10
#DB_BUSY_TIMEOUT_MS=5000
#BACKUPS_MAX_COPIAS=14

# ── Mercado y proveedores ─────────────────────────────────────────────────────
#MERCADO_HISTORICO_TTL=14400
#MERCADO_MAX_PARALELAS=6
#PROVEEDORES_TIMEOUT=10
#PROVEEDORES_REINTENTOS=2

# ── Rutas (ejecución directa, sin Docker) ─────────────────────────────────────
# Relativas a la raíz del proyecto, o absolutas. Dentro del contenedor las fija
# docker-compose.yml a /app/data, /app/logs y /app/API, que es donde montan los
# volúmenes; para mover los datos con Docker usa las variables de abajo.
#PORTFOLIO_DATA_DIR=data
#PORTFOLIO_LOGS_DIR=logs
#PORTFOLIO_API_DIR=API

# ── Rutas en el host (solo Docker) ────────────────────────────────────────────
# Lado del host de cada volumen. Cámbialas para guardar los datos en otro disco.
#PORTFOLIO_HOST_DATA_DIR=./data
#PORTFOLIO_HOST_LOGS_DIR=./logs
#PORTFOLIO_HOST_API_DIR=./API

# ── Healthcheck del contenedor ────────────────────────────────────────────────
#HEALTHCHECK_INTERVAL=30s
#HEALTHCHECK_TIMEOUT=10s
#HEALTHCHECK_RETRIES=3
#HEALTHCHECK_START_PERIOD=15s

# Ruta a un config.ini alternativo (por defecto, el de la raíz del proyecto).
#PORTFOLIO_CONFIG=/ruta/a/config.ini
