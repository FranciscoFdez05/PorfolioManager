# Claves de API
# Copia este archivo como .env y completa los valores
# Alternativa: sigue usando los archivos en API/*.key (compatibilidad mantenida)

FINNHUB_API_KEY=tu_clave_finnhub

# Multiples keys EODHD separadas por coma (para rotacion automatica)
EODHD_API_KEYS=tu_clave_eodhd_1,tu_clave_eodhd_2

# Servidor
FLASK_DEBUG=false
