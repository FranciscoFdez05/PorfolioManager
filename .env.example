# Copia este archivo como .env y rellena los valores antes de lanzar el contenedor.

# ── API keys ──────────────────────────────────────────────────────────────────
FINNHUB_API_KEY=tu_clave_finnhub

# Múltiples keys EODHD separadas por coma (rotación automática)
EODHD_API_KEYS=tu_clave_EODHD1,tu_clave_EODHD2

# ── Servidor ──────────────────────────────────────────────────────────────────
# Puerto: la fuente de verdad es [server] port en config.ini. Si lanzas el
# stack con ./docker-up.sh, este valor se sobrescribe automáticamente con el
# de config.ini. Solo se usa tal cual si ejecutas "docker compose up" a mano
# sin pasar por docker-up.sh.
PORT=5000
FLASK_DEBUG=false

# Zona horaria (afecta a logs y auto-backup)
TZ=Europe/Madrid

# Activa la cookie de sesión segura; ponlo en true solo si hay HTTPS delante
HTTPS_ENABLED=false

# ── Seguridad ─────────────────────────────────────────────────────────────────
# Genera una clave aleatoria con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_aleatoria_larga

# ── Credenciales de acceso ────────────────────────────────────────────────────
# Se usan solo en el primer arranque (o si data/auth.dat no existe).
# Tras el primer login puedes cambiarlas desde Ajustes > Credenciales.
LOGIN_USERNAME=admin

# Genera el hash con:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('tu_contraseña', method='pbkdf2:sha256:600000'))"
LOGIN_PASSWORD_HASH=
