# Claves de API
# Copia este archivo como .env y completa los valores
# Alternativa: sigue usando los archivos en API/*.key (compatibilidad mantenida)

FINNHUB_API_KEY=tu_clave_finnhub

# Multiples keys EODHD separadas por coma (para rotacion automatica)
EODHD_API_KEYS=tu_clave_EODHD1,tu_clave_EODHD2

# Servidor
FLASK_DEBUG=false

# Clave de sesión Flask (genera una aleatoria con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=cambia_esto_por_una_clave_aleatoria_larga

# Credenciales de login (solo para primer arranque / Docker)
# Las credenciales se guardan en data/auth.json tras el primer inicio.
# Cambiarlas desde Ajustes > Credenciales de acceso no requiere tocar estas variables.
# Si data/auth.json no existe y estas variables tampoco, se usa admin/admin por defecto.
LOGIN_USERNAME=admin
LOGIN_PASSWORD_HASH=
